# ============================================================================
# Blackwing by Tinycrows — configuration
# Copy this file to ".env" and fill in the values. NEVER commit your real .env.
# ============================================================================

# ── Web console (what your users open) ──────────────────────────────────────
# Port on your machine for the Blackwing GUI: http://localhost:<port>
BLACKWING_GUI_PORT=8080

# Sign-in for the GUI (seeded on first boot; change the password afterwards).
BLACKWING_ADMIN_EMAIL=admin@tinycrows.com
BLACKWING_ADMIN_PASSWORD=change-this-password

# Secret used to sign GUI session tokens. Use a long random string.
JWT_SECRET=please-change-this-to-a-long-random-string

# ── AWS Bedrock (the AI models that power the engine) ───────────────────────
# Paste your Bedrock API key here. This is the value of AWS_BEARER_TOKEN_BEDROCK.
# The engine automatically uses the best available Claude models on Bedrock
# (Opus for deep reasoning, Sonnet/Haiku for support roles) — no model config needed.
BEDROCK_BEARER_TOKEN=
BEDROCK_REGION=us-east-1
# Leave BEDROCK_DEFAULT_AUTH empty to use the bearer token above. Set it to
# "true" only if you instead want the AWS SDK default credential chain.
BEDROCK_DEFAULT_AUTH=
# Alternative to the bearer token: static IAM keys (leave blank if using the token).
BEDROCK_ACCESS_KEY_ID=
BEDROCK_SECRET_ACCESS_KEY=

# ── Engine internals (safe defaults; change the secrets for production) ──────
COOKIE_SIGNING_SALT=change-this-random-salt
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=pentagidb
SCRAPER_USER=someuser
SCRAPER_PASSWORD=change-this-scraper-password

# Path to the host Docker socket (the engine runs its tools in containers).
# Linux/macOS default below. On Docker Desktop this is usually correct as-is.
DOCKER_SOCKET=/var/run/docker.sock

# ── Advanced (optional) ─────────────────────────────────────────────────────
# DEBUG=false
# BLACKWING_ENGINE_IMAGE=vxcontrol/pentagi:latest
# The engine's own admin login (used internally by the GUI to drive it).
# BLACKWING_ENGINE_EMAIL=admin@pentagi.com
# BLACKWING_ENGINE_PASSWORD=admin
